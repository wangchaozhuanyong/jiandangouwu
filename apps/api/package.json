{
  "name": "@cloudbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "node scripts/generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env scripts/migrate-deploy.mjs",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "verify:admin-sessions": "node --env-file-if-exists=../../.env --import tsx scripts/verify-admin-sessions.ts",
    "verify:inventory-risk": "node --env-file-if-exists=../../.env --import tsx scripts/verify-inventory-risk.ts",
    "verify:order-reservations": "node --env-file-if-exists=../../.env --import tsx scripts/verify-order-reservations.ts",
    "test": "npm run build && node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@cloudbridge/contracts": "0.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "mariadb": "3.4.5",
    "otplib": "13.4.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}

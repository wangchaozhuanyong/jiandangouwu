generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ContentLocale {
  ZH
  EN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum StockMode {
  FINITE
  UNLIMITED
}

enum HeroStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ContactChannelType {
  WHATSAPP
  EMAIL
  TELEGRAM
  WECHAT
  QQ
}

enum ContactChannelMode {
  DIRECT_LINK
  DIRECT_WITH_FALLBACK
  QR_COPY
}

enum OrderStatus {
  MANUAL_PENDING
  CONTACTED
  AWAITING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  FULFILLING
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum PaymentMode {
  MANUAL
}

enum AdminStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum AuditResult {
  SUCCEEDED
  FAILED
  DENIED
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique @db.VarChar(120)
  status       ProductStatus         @default(ACTIVE)
  sortOrder    Int                   @default(0)
  version      Int                   @default(1)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations CategoryTranslation[]
  products     Product[]

  @@index([status, sortOrder])
}

model CategoryTranslation {
  id         String        @id @default(cuid())
  categoryId String
  locale     ContentLocale
  name       String        @db.VarChar(160)
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model Product {
  id                String               @id @default(cuid())
  slug              String               @unique @db.VarChar(160)
  categoryId        String
  imageKey          String               @db.VarChar(512)
  basePrice         Decimal              @db.Decimal(18, 2)
  compareAtPrice    Decimal?             @db.Decimal(18, 2)
  stockMode         StockMode            @default(FINITE)
  stockQuantity     Int?
  status            ProductStatus        @default(DRAFT)
  sortOrder         Int                  @default(0)
  version           Int                  @default(1)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  category          Category             @relation(fields: [categoryId], references: [id])
  translations      ProductTranslation[]
  orders            Order[]

  @@index([categoryId, status, sortOrder])
  @@index([status, sortOrder])
}

model ProductTranslation {
  id          String        @id @default(cuid())
  productId   String
  locale      ContentLocale
  name        String        @db.VarChar(200)
  normalizedName String     @db.VarChar(220)
  kicker      String        @db.VarChar(180)
  description String        @db.Text
  aliases     Json?
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale, normalizedName])
}

model Hero {
  id           String            @id @default(cuid())
  key          String            @unique @db.VarChar(80)
  imageKey     String            @db.VarChar(512)
  targetSlug   String?           @db.VarChar(160)
  tone         String            @db.VarChar(40)
  status       HeroStatus        @default(ACTIVE)
  sortOrder    Int               @default(0)
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations HeroTranslation[]

  @@index([status, sortOrder])
}

model HeroTranslation {
  id       String        @id @default(cuid())
  heroId   String
  locale   ContentLocale
  eyebrow  String        @db.VarChar(160)
  title    String        @db.VarChar(300)
  body     String        @db.Text
  cta      String        @db.VarChar(120)
  hero     Hero          @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, locale])
}

model Currency {
  code       String         @id @db.Char(4)
  token      String         @db.VarChar(12)
  nameZh     String         @db.VarChar(120)
  nameEn     String         @db.VarChar(120)
  digits     Int            @default(2)
  active     Boolean        @default(true)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  ratesFrom  ExchangeRate[] @relation("RateFrom")
  ratesTo    ExchangeRate[] @relation("RateTo")
  orders     Order[]

  @@index([active, sortOrder])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCode     String   @db.Char(4)
  toCode       String   @db.Char(4)
  rate         Decimal  @db.Decimal(24, 10)
  source       String   @db.VarChar(120)
  effectiveAt  DateTime
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  fromCurrency Currency @relation("RateFrom", fields: [fromCode], references: [code])
  toCurrency   Currency @relation("RateTo", fields: [toCode], references: [code])

  @@unique([fromCode, toCode, effectiveAt])
  @@index([fromCode, toCode, effectiveAt])
}

model MerchantChannel {
  id            String             @id @default(cuid())
  type          ContactChannelType @unique
  mode          ContactChannelMode
  labelZh       String             @db.VarChar(80)
  labelEn       String             @db.VarChar(80)
  publicAccount String             @db.VarChar(240)
  directTarget  String?            @db.VarChar(512)
  serviceHoursZh String            @db.VarChar(120)
  serviceHoursEn String            @db.VarChar(120)
  active        Boolean            @default(true)
  sortOrder     Int                @default(0)
  version       Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([active, sortOrder])
}

model Order {
  id                    String             @id @default(cuid())
  orderNumber           String             @unique @db.VarChar(32)
  idempotencyKey        String             @unique @db.VarChar(120)
  productId             String
  productNameSnapshot   String             @db.VarChar(200)
  currencyCode          String             @db.Char(4)
  amount                Decimal            @db.Decimal(18, 2)
  referenceCurrencyCode String?            @db.Char(4)
  referenceAmount       Decimal?           @db.Decimal(18, 2)
  exchangeRateSnapshot  Decimal            @db.Decimal(24, 10)
  productVersion        Int
  contactChannel        ContactChannelType
  contactEncrypted      String             @db.Text
  contactHash           String             @db.Char(64)
  maskedContact         String             @db.VarChar(240)
  acceptedPolicyVersion String             @db.VarChar(80)
  status                OrderStatus        @default(MANUAL_PENDING)
  paymentMode           PaymentMode        @default(MANUAL)
  reservedUntil         DateTime
  assignedToId          String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  product               Product            @relation(fields: [productId], references: [id])
  currency              Currency           @relation(fields: [currencyCode], references: [code])
  assignedTo            AdminUser?         @relation(fields: [assignedToId], references: [id])
  statusHistory         OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([productId, createdAt])
  @@index([assignedToId, status])
}

model OrderStatusHistory {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?     @db.VarChar(500)
  actorId    String?
  createdAt  DateTime    @default(now())
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor      AdminUser?  @relation(fields: [actorId], references: [id])

  @@index([orderId, createdAt])
}

model AdminUser {
  id                  String               @id @default(cuid())
  email               String               @unique @db.VarChar(254)
  displayName         String               @db.VarChar(120)
  passwordHash        String?              @db.Text
  status              AdminStatus          @default(INVITED)
  totpSecretEncrypted String?              @db.Text
  totpEnabled         Boolean              @default(false)
  failedLoginCount    Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  roles               AdminUserRole[]
  assignedOrders      Order[]
  orderStatusHistory  OrderStatusHistory[]
  auditEvents         AuditEvent[]

  @@index([status])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(80)
  nameZh      String           @db.VarChar(120)
  nameEn      String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       AdminUserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(120)
  description String?          @db.VarChar(500)
  roles       RolePermission[]
}

model AdminUserRole {
  adminUserId String
  roleId      String
  assignedAt  DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
}

model RolePermission {
  roleId      String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditEvent {
  id         String      @id @default(cuid())
  actorId    String?
  action     String      @db.VarChar(120)
  targetType String      @db.VarChar(80)
  targetId   String?     @db.VarChar(160)
  result     AuditResult
  requestId  String      @db.VarChar(80)
  reason     String?     @db.VarChar(500)
  beforeData Json?
  afterData  Json?
  ipHash     String?     @db.Char(64)
  createdAt  DateTime    @default(now())
  actor      AdminUser?  @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

model SiteSetting {
  key       String   @id @db.VarChar(120)
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

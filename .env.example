# Legacy frontend-only preview
VITE_API_BASE_URL=http://localhost:3001/v1

# Local MySQL 8.4 development
MYSQL_DATABASE=cloudbridge
MYSQL_USER=cloudbridge
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3307
DATABASE_URL=mysql://cloudbridge:replace-with-local-password@127.0.0.1:3307/cloudbridge
SHADOW_DATABASE_URL=mysql://cloudbridge:replace-with-local-password@127.0.0.1:3307/cloudbridge_shadow
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=cloudbridge
DB_USER=cloudbridge
DB_PASSWORD=replace-with-local-password
DB_TLS=false
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Local Redis-compatible session store
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=replace-with-cache-password
REDIS_TLS=false

# API
API_PORT=3001
API_PUBLIC_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5176
SESSION_COOKIE_NAME=cloudbridge_admin_session
SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Public clients
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_ADMIN_API_BASE_URL=http://localhost:3001/v1
VITE_ADMIN_AUTH_PROVIDER=password
VITE_BASE_PATH=/

# Sites local runtime only; production values are managed by Sites
CLOUDBRIDGE_DATA_KEY=replace-with-32-byte-base64url-key
CODEX_SANDBOX=
WRANGLER_WRITE_LOGS=false
WRANGLER_LOG_PATH=.wrangler/logs
MINIFLARE_REGISTRY_PATH=.wrangler/registry

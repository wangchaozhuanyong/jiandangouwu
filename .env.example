# Sites-only clients
NEXT_PUBLIC_API_BASE_URL=/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VITE_ADMIN_API_BASE_URL=/v1
VITE_ADMIN_AUTH_PROVIDER=sites
VITE_BASE_PATH=/

# Sites local runtime only. Production secrets are managed by Sites and never committed.
CLOUDBRIDGE_DATA_KEY=replace-with-32-byte-base64url-key
CLOUDBRIDGE_DATA_KEY_NEXT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDER_CHAT_ID=
CODEX_SANDBOX=
WRANGLER_WRITE_LOGS=false
WRANGLER_LOG_PATH=.wrangler/logs
MINIFLARE_REGISTRY_PATH=.wrangler/registry
